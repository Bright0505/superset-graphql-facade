# ============================================================
# 此檔僅供本機開發使用
# CI/CD 部署時 SUPERSET_URL 與 REDIS_URL 由 .gitlab-ci.yml 動態注入,
# 指向同 docker network 內的 gt-war-room-superset-internal[-dev]
# 與 gt-war-room-redis[-dev],無須在 DEV_API/PROD_API 變數內設定
# ============================================================

# --- Server ---
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# --- Superset upstream ---
# 本機開發:直接連 dev/prd 外部 Superset(受 DASHBOARD_RBAC 過濾)
# 開發用:https://rep-lab.greattree.com.tw
# 正式用:https://rep.greattree.com.tw
SUPERSET_URL=https://rep-lab.greattree.com.tw
SUPERSET_USERNAME=api
SUPERSET_PASSWORD=

# --- Redis(Phase 2 啟用)---
REDIS_URL=redis://localhost:6379

# --- 客戶端認證(API Key,以逗號分隔)---
# 範例:API_KEYS=internal-frontend:abcd1234,partner-x:efgh5678
API_KEYS=

# --- Rate limit ---
# 每個 API key 每分鐘最大請求數，0 = 停用
RATE_LIMIT_RPM=60

# --- per-scope 資料認證（方案 A — 範圍帳號，見 docs/facade-permission-design.md §0）---
# 預設 service-account：維持現有行為，下列 per-scope 設定均不生效
# 切換為 per-scope 前，請先確認頭號待解事項（§0.3）
DATA_AUTH_MODE=service-account

# IdP JWKS 端點（驗 X-User-Token header 簽章；未設定時開發模式僅 decode）
USER_JWT_JWKS_URI=
USER_JWT_ISSUER=
USER_JWT_AUDIENCE=
# IdP JWT 中代表範圍的 claim 欄位（預設 "region"）
USER_JWT_SCOPE_CLAIM=region

# 範圍帳號憑證：JSON { "scopeKey": "superset-username:password" }
# ⚠️ 含密碼，正式環境請由 Secret Manager / Vault 注入，勿提交
# 範例：{"中投一區": "scope_ztyi1:P@ss", "商場一部": "scope_mall1:P@ss"}
SCOPE_CREDENTIALS={}
